#!/usr/bin/env bash
#
# Pre-commit hook for Learning Flywheel governance enforcement
#
# This hook validates SKILL.md files before they are committed to prevent:
# 1. Invalid YAML frontmatter from entering the repository
# 2. Skills exceeding context budget (500 lines)
# 3. Negative Knowledge changes without version bumps
# 4. Missing required sections
#
# To bypass this hook (NOT recommended), use: git commit --no-verify
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 Running Learning Flywheel governance checks..."

# Get the repository root
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# Check if Python is available
if ! command -v python3 &> /dev/null; then
    echo -e "${RED}❌ Python 3 is required but not found${NC}"
    exit 1
fi

# Get list of staged SKILL.md files
STAGED_SKILLS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.claude/skills/.*/SKILL\.md$' || true)

if [ -z "$STAGED_SKILLS" ]; then
    echo -e "${GREEN}✅ No SKILL.md files staged for commit${NC}"
    exit 0
fi

# Count staged skills
SKILL_COUNT=$(echo "$STAGED_SKILLS" | wc -l)
echo "📄 Found $SKILL_COUNT staged SKILL.md file(s) to validate"

# Validate each staged skill
VALIDATION_FAILED=0
FAILED_SKILLS=()

while IFS= read -r skill_file; do
    if [ -n "$skill_file" ]; then
        echo ""
        echo "Validating: $skill_file"

        # Run validation in strict mode (warnings are errors)
        if ! python3 scripts/validate_memory.py --skill "$skill_file" --strict; then
            VALIDATION_FAILED=1
            FAILED_SKILLS+=("$skill_file")
        fi
    fi
done <<< "$STAGED_SKILLS"

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if [ $VALIDATION_FAILED -eq 1 ]; then
    echo -e "${RED}❌ COMMIT BLOCKED: Skill validation failed${NC}"
    echo ""
    echo "Failed files:"
    for failed_skill in "${FAILED_SKILLS[@]}"; do
        echo -e "${RED}  • $failed_skill${NC}"
    done
    echo ""
    echo "Fix the errors above before committing."
    echo ""
    echo -e "${YELLOW}To bypass this hook (NOT recommended):${NC}"
    echo "  git commit --no-verify"
    echo ""
    exit 1
else
    echo -e "${GREEN}✅ All staged SKILL.md files passed validation${NC}"
    echo ""
    exit 0
fi
